---
import HeroEditorial from "@/components/hero/HeroEditorial.astro";
import Container from "@/components/layout/Container.astro";
import Section from "@/components/layout/Section.astro";
import Split from "@/components/layout/Split.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import Figure from "@/components/ui/Figure.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { home } from "@/content/home";
import { image } from "@/lib/images";
---

<MainLayout title={home.seo.title} description={home.seo.description}>
  <HeroEditorial
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    lede={home.hero.lede}
    primaryCta={home.hero.primaryCta}
    secondaryCta={home.hero.secondaryCta}
    aside={home.hero.aside}
    image={home.hero.image ? image(home.hero.image) : undefined}
    imageAlt={home.hero.imageAlt}
    imageWidth={home.hero.imageWidth}
    imageHeight={home.hero.imageHeight}
    imageLayout={home.hero.imageLayout}
    imageCredit={home.hero.imageCredit}
    imageCreditHref={home.hero.imageCreditHref}
  />

  <Section class="bg-muted/60">
    <Container>
      <Split>
        <Fragment slot="primary">
          <Badge>{home.audiences.eyebrow}</Badge>
          <h2 class="mt-4 text-3xl md:text-4xl">{home.audiences.title}</h2>
          <p class="mt-5 max-w-prose text-pretty text-muted-foreground">{home.audiences.text}</p>
        </Fragment>
        <ul slot="secondary" class="space-y-0 md:mt-12">
          {
            home.audiences.items.map((item) => (
              <li class="border-t border-border py-4 font-serif text-xl first:border-t-0 first:pt-0">
                {item}
              </li>
            ))
          }
        </ul>
      </Split>
    </Container>
  </Section>

  <Section>
    <Container>
      <div class="md:max-w-xl">
        <Badge>{home.offerings.eyebrow}</Badge>
        <h2 class="mt-4 text-3xl md:text-4xl">{home.offerings.title}</h2>
      </div>
      <ol class="mt-12 divide-y divide-border border-y border-border">
        {
          home.offerings.items.map((item, index) => (
            <li class="grid gap-4 py-8 md:grid-cols-12 md:items-baseline">
              <p class="text-sm text-muted-foreground md:col-span-2">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3 class="font-serif text-2xl md:col-span-4">{item.title}</h3>
              <p class="text-muted-foreground md:col-span-6">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section class="bg-foreground text-background">
    <Container>
      <div class="max-w-xl">
        <h2 class="text-3xl md:text-4xl">{home.paths.title}</h2>
        <p class="mt-4 text-background/75">{home.paths.text}</p>
      </div>
      <ol class="mt-12 divide-y divide-background/20 border-y border-background/20">
        {
          home.paths.items.map((item, index) => (
            <li class="grid gap-4 py-8 md:grid-cols-12 md:items-baseline">
              <p class="text-sm text-highlight md:col-span-2">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h3 class="font-serif text-2xl md:col-span-4">{item.title}</h3>
              <div class="md:col-span-6">
                <p class="text-background/75">{item.text}</p>
                <p class="mt-4">
                  <Button href={item.href} variant="inverse">
                    {item.hrefLabel}
                  </Button>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section class="border-t border-border">
    <Container class="grid gap-12 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5">
        {
          home.close.image && (
            <Figure
              src={image(home.close.image)}
              alt={home.close.imageAlt}
              width={home.close.imageWidth}
              height={home.close.imageHeight}
              credit={home.close.imageCredit}
              creditHref={home.close.imageCreditHref}
              sizes="(min-width: 768px) 40vw, 100vw"
            />
          )
        }
      </div>
      <div class="md:col-span-7">
        <h2 class="text-3xl">{home.close.title}</h2>
        <p class="mt-5 max-w-prose text-lg text-pretty text-muted-foreground">{home.close.text}</p>
      </div>
    </Container>
  </Section>
</MainLayout>
