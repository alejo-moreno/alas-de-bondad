---
import HeroMinimal from "@/components/hero/HeroMinimal.astro";
import Container from "@/components/layout/Container.astro";
import Section from "@/components/layout/Section.astro";
import Stack from "@/components/layout/Stack.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { nosotros } from "@/content/nosotros";
---

<MainLayout title={nosotros.seo.title} description={nosotros.seo.description}>
  <HeroMinimal
    eyebrow={nosotros.hero.eyebrow}
    title={nosotros.hero.title}
    lede={nosotros.hero.lede}
  />

  <Section>
    <Container class="grid gap-16 md:grid-cols-12">
      <Stack gap="lg" class="md:col-span-7">
        {
          nosotros.body.map((paragraph) => (
            <p class="text-lg text-pretty">{paragraph}</p>
          ))
        }
      </Stack>
      <ol class="md:col-span-5 md:pt-2">
        {
          nosotros.principles.map((item, index) => (
            <li class="border-t border-border py-6 first:border-t-0 first:pt-0">
              <p class="text-sm text-muted-foreground">{String(index + 1).padStart(2, "0")}</p>
              <h2 class="mt-2 font-serif text-2xl">{item.title}</h2>
              <p class="mt-3 text-muted-foreground">{item.text}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </Section>

  <Section class="border-t border-border">
    <Container class="grid gap-8 md:grid-cols-12">
      <h2 class="text-3xl md:col-span-5">{nosotros.territory.title}</h2>
      <p class="max-w-prose text-lg text-pretty text-muted-foreground md:col-span-7">
        {nosotros.territory.text}
      </p>
    </Container>
  </Section>

  <Section id={nosotros.documents.id} class="scroll-mt-24 border-t border-border bg-muted/60">
    <Container class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 class="text-3xl md:text-4xl">{nosotros.documents.title}</h2>
        <p class="mt-5 max-w-prose text-pretty text-muted-foreground">{nosotros.documents.text}</p>
      </div>
      <ul class="divide-y divide-border border-y border-border md:col-span-7">
        {
          nosotros.documents.items.map((item) => (
            <li>
              <a
                href={item.href}
                type="application/pdf"
                target="_blank"
                rel="noopener"
                class="grid gap-1 py-5 md:grid-cols-12 md:items-baseline md:gap-4"
              >
                <span class="font-serif text-2xl md:col-span-8">{item.title}</span>
                <span class="text-sm text-muted-foreground md:col-span-4 md:text-right">PDF</span>
                <span class="text-muted-foreground md:col-span-8">{item.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </Section>
</MainLayout>
