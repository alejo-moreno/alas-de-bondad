---
import type { ImageMetadata } from "astro";
import Container from "@/components/layout/Container.astro";
import Section from "@/components/layout/Section.astro";
import Badge from "@/components/ui/Badge.astro";
import Figure from "@/components/ui/Figure.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata | string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  secondaryImage?: ImageMetadata | string;
  secondaryImageAlt?: string;
  secondaryImageWidth?: number;
  secondaryImageHeight?: number;
}

const {
  eyebrow,
  title,
  lede,
  image,
  imageAlt = "",
  imageWidth,
  imageHeight,
  secondaryImage,
  secondaryImageAlt = "",
  secondaryImageWidth,
  secondaryImageHeight,
} = Astro.props;
---

<Section class="border-b border-border py-12 md:py-16">
  <Container>
    {
      image && secondaryImage ? (
        <div class="grid items-start gap-8 md:grid-cols-12 md:gap-10">
          <div class="md:col-span-5">
            {eyebrow && <Badge>{eyebrow}</Badge>}
            <h1 class="mt-4 text-3xl text-balance md:text-5xl">{title}</h1>
            {lede && <p class="mt-5 text-pretty text-muted-foreground">{lede}</p>}
          </div>
          <div class="grid grid-cols-2 gap-3 md:col-span-7 md:gap-4">
            <Figure
              src={image}
              alt={imageAlt}
              width={imageWidth}
              height={imageHeight}
              loading="eager"
              sizes="(min-width: 768px) 22rem, 45vw"
            />
            <Figure
              src={secondaryImage}
              alt={secondaryImageAlt}
              width={secondaryImageWidth}
              height={secondaryImageHeight}
              loading="eager"
              sizes="(min-width: 768px) 22rem, 45vw"
            />
          </div>
        </div>
      ) : image ? (
        <div class="grid items-start gap-10 md:grid-cols-12">
          <div class="md:col-span-7">
            {eyebrow && <Badge>{eyebrow}</Badge>}
            <h1 class="mt-4 max-w-3xl text-3xl text-balance md:text-5xl">{title}</h1>
            {lede && <p class="mt-5 max-w-2xl text-pretty text-muted-foreground">{lede}</p>}
          </div>
          <Figure
            src={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            loading="eager"
            sizes="18rem"
            class="w-full max-w-72 md:col-span-5 md:col-start-8 md:justify-self-start"
          />
        </div>
      ) : (
        <>
          {eyebrow && <Badge>{eyebrow}</Badge>}
          <h1 class="mt-4 max-w-3xl text-3xl text-balance md:text-5xl">{title}</h1>
          {lede && <p class="mt-5 max-w-2xl text-pretty text-muted-foreground">{lede}</p>}
        </>
      )
    }
  </Container>
</Section>
