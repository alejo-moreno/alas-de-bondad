---
import { site } from "@/config/site";
import { isPlaceholder } from "@/lib/links";

const address =
  !isPlaceholder(site.location.address) || !isPlaceholder(site.location.city)
    ? {
        "@type": "PostalAddress",
        streetAddress: isPlaceholder(site.location.address)
          ? undefined
          : site.location.address,
        addressLocality: isPlaceholder(site.location.city)
          ? undefined
          : site.location.city,
        addressRegion: site.location.region || undefined,
        addressCountry: isPlaceholder(site.location.country)
          ? undefined
          : site.location.country,
      }
    : undefined;

const data = {
  "@context": "https://schema.org",
  "@type": site.schemaType,
  name: site.name,
  description: site.description,
  url: site.url,
  email: isPlaceholder(site.contact.email) ? undefined : site.contact.email,
  telephone: isPlaceholder(site.contact.phone) ? undefined : site.contact.phone,
  address,
};

const json = JSON.stringify(data, (_key, value) => (value === undefined ? undefined : value));
---

<script is:inline type="application/ld+json" set:html={json} />
