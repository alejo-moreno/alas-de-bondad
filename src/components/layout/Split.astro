---
import { cx } from "@/lib/cx";

interface Props {
  class?: string;
  reverse?: boolean;
  align?: "start" | "end" | "stretch";
}

const alignClass = {
  start: "md:items-start",
  end: "md:items-end",
  stretch: "md:items-stretch",
} as const;

const { class: className, reverse = false, align = "start" } = Astro.props;
---

<div
  class={cx(
    "grid gap-10 md:grid-cols-12",
    alignClass[align],
    className,
  )}
>
  <div class={cx("md:col-span-7", reverse && "md:order-2")}>
    <slot name="primary" />
    <slot />
  </div>
  <div class={cx("md:col-span-5", reverse && "md:order-1")}>
    <slot name="secondary" />
  </div>
</div>
