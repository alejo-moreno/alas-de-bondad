---
import { cx } from "@/lib/cx";

interface Props {
  class?: string;
  gap?: "sm" | "md" | "lg";
}

const gaps = {
  sm: "gap-3",
  md: "gap-6",
  lg: "gap-10",
} as const;

const { class: className, gap = "md" } = Astro.props;
---

<div class={cx("flex flex-col", gaps[gap], className)}>
  <slot />
</div>
