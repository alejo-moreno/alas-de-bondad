---
import { cx } from "@/lib/cx";

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  level?: 1 | 2 | 3;
  class?: string;
}

const { eyebrow, title, lede, level = 2, class: className } = Astro.props;
const Tag = `h${level}` as "h1" | "h2" | "h3";
---

<header class={cx("max-w-2xl", className)}>
  {eyebrow && (
    <p class="text-sm tracking-wide text-muted-foreground">{eyebrow}</p>
  )}
  <Tag class={cx(level === 1 ? "mt-3 text-4xl md:text-5xl" : "mt-3 text-3xl md:text-4xl")}>
    {title}
  </Tag>
  {lede && <p class="mt-5 text-lg text-muted-foreground text-pretty">{lede}</p>}
</header>
