---
import { cx } from "@/lib/cx";

export interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: AccordionItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class={cx("divide-y divide-border border-y border-border", className)}>
  {
    items.map((item) => (
      <details class="group py-4">
        <summary class="cursor-pointer list-none py-1 pr-8 text-left text-lg marker:content-none [&::-webkit-details-marker]:hidden">
          <span class="flex items-start justify-between gap-6">
            <span>{item.question}</span>
            <span aria-hidden="true" class="text-muted-foreground group-open:hidden">
              +
            </span>
            <span aria-hidden="true" class="hidden text-muted-foreground group-open:inline">
              −
            </span>
          </span>
        </summary>
        <p class="mt-3 max-w-prose text-muted-foreground">{item.answer}</p>
      </details>
    ))
  }
</div>
