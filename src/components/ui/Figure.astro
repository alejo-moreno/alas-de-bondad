---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { cx } from "@/lib/cx";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  sizes?: string;
  credit?: string;
  creditHref?: string;
  imageClass?: string;
  /** Keep scannable graphics (QR) as PNG instead of the default WebP. */
  format?: "png" | "webp" | "avif" | "jpeg" | "jpg";
  quality?: number | "low" | "mid" | "high" | "max";
}

const {
  src,
  alt,
  class: className,
  width = 1200,
  height = 840,
  loading = "lazy",
  sizes = "(min-width: 768px) 40vw, 100vw",
  credit,
  creditHref,
  imageClass = "h-auto w-full",
  format,
  quality,
} = Astro.props;

const remote = typeof src === "string";
const transform = {
  ...(format ? { format } : {}),
  ...(quality !== undefined ? { quality } : {}),
};
---

<figure class={cx("m-0", className)}>
  {
    remote ? (
      <img
        src={src}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
    ) : src.format === "svg" ? (
      <img
        src={src.src}
        alt={alt}
        width={src.width || width}
        height={src.height || height}
        loading={loading}
        decoding="async"
        class={imageClass}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        layout="constrained"
        width={width}
        height={height}
        loading={loading}
        sizes={sizes}
        class={imageClass}
        {...transform}
      />
    )
  }
  {
    credit && (
      <figcaption class="mt-2 text-sm text-muted-foreground">
        {
          creditHref ? (
            <a href={creditHref} class="underline underline-offset-4">
              {credit}
            </a>
          ) : (
            credit
          )
        }
      </figcaption>
    )
  }
</figure>
